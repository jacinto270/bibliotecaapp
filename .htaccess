# No mostrar el listado de archivos de la carpeta
Options -Indexes

# Archivos que no se deben poder abrir desde el navegador:
# las copias de la base de datos, la configuración y los archivos que solo se incluyen desde otras páginas
<FilesMatch "\.(sql|md|log|ini|bak)$|^(conexion|funciones|cabecera|pie|prueba)\.php$|^\.">
    Require all denied
</FilesMatch>

# Ni la carpeta .git ni otros archivos ocultos (por si se suben al servidor)
RedirectMatch 404 /\.(?!well-known/)
